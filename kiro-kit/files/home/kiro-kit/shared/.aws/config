# Shared AWS config delivered into the sandbox at ~/.aws/config.
#
# This file intentionally contains ONLY the shared SSO session (the GOV.UK One
# Login start URL, which is already public in spec.yaml). It does NOT define any
# account-specific profiles, because account IDs and permission sets are not
# committed to this public repository.
#
# To add a profile, create the gitignored file
# files/home/kiro-kit/personal/.aws/config with your [profile ...] block(s)
# (see the kit README, "AWS SSO profiles"). It is appended on top of this
# shared config at startup.
#
# Once a profile is available in the sandbox, authenticate with:
#     aws sso login --profile <profile-name>
# Your SSO login supplies your personal identity; nothing user-specific lives
# in this file.

[sso-session uk-digital-identity]
sso_start_url = https://uk-digital-identity.awsapps.com/start/
sso_region = eu-west-2
sso_registration_scopes = sso:account:access
